APP_ENV=development
APP_SECRET=replace-this-before-deployment
DATABASE_URL=sqlite:///./latentsig.db
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
WHATSAPP_NUMBER=
ADMIN_EMAIL_ALLOWLIST=raksha@latentsig.com,bhoomika@latentsig.com,bharat@latentsig.com,info@latentsig.com,shauryasharthak@latentsig.com
INITIAL_ADMIN_EMAILS=bharat@latentsig.com,bhoomika@latentsig.com
DEFAULT_EVENT_SLUG=bts-2026
MAX_UPLOAD_BYTES=10485760
DEFAULT_PHONE_REGION=IN
PRIVATE_STORAGE_DIR=./private_storage
BUSINESS_CARD_RETENTION_DAYS=90
CONSENT_NOTICE_VERSION=2026-10-21-v1
REDIS_URL=
LEAD_RATE_LIMIT_COUNT=20
LEAD_RATE_LIMIT_WINDOW_SECONDS=600
OCR_RATE_LIMIT_COUNT=10
OCR_RATE_LIMIT_WINDOW_SECONDS=300
# OpenRouter credentials are backend-only. Leave the key empty in this template.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.8-flash
OCR_PROVIDER=openrouter
OCR_TIMEOUT_SECONDS=20
OCR_MAX_RETRIES=2
OCR_MAX_OUTPUT_TOKENS=1000
OCR_ENABLED=true
AUTH_RATE_LIMIT_COUNT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
