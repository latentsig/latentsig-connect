# Copy this file to the repository root as .env and replace secret placeholders.
# scripts/Initialize-Production.ps1 generates unique APP_SECRET and POSTGRES_PASSWORD values.
APP_ENV=production
APP_SECRET=replace-with-generated-random-value
POSTGRES_PASSWORD=replace-with-generated-random-value
PUBLIC_DOMAIN=connect.latentsig.com
CERTBOT_EMAIL=bhoomika@latentsig.com
FRONTEND_URL=https://connect.latentsig.com
FRONTEND_URLS=https://connect.latentsig.com
GOOGLE_REDIRECT_URI=https://connect.latentsig.com/api/v1/auth/google/callback
ADMIN_EMAIL_ALLOWLIST=bhoomika@latentsig.com,bharat@latentsig.com
INITIAL_ADMIN_EMAILS=bhoomika@latentsig.com
OPENROUTER_API_KEY=
# Enable OCR only after setting OPENROUTER_API_KEY in this ignored .env file.
OCR_ENABLED=false
OPENROUTER_MODEL=google/gemini-3.8-flash
CONSENT_NOTICE_VERSION=2026-10-21-v1
